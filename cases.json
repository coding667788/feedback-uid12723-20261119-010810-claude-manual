    {
      "id": "02-exact-expiry-boundary",
      "why": "An invitation is usable strictly before expires_at and expired at expires_at. Both checks happen at the same virtual millisecond.",
      "start_at": "2026-01-01T00:00:00Z",
      "ops": [
